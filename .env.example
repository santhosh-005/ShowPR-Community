# ShowPR Community Edition - Environment Variables
# Copy this file to .env.local and fill in the values

# ========================
# MANDATORY
# ========================

# GitHub OAuth App — https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# NextAuth.js — generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Public base URL of your deployment
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase — from project settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AES-256 encryption key — generate: openssl rand -hex 32
AES_KEY=

# GitHub Webhook verification secret
GITHUB_WEBHOOK_SECRET=

# ========================
# OPTIONAL
# ========================

# Sentry error tracking — https://sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Webhook endpoints for feedback and welcome emails
NEXT_PUBLIC_FEEDBACK_WEBHOOK_URL=
NEXT_PUBLIC_WELCOME_EMAIL_WEBHOOK_URL=

# Twitter handle for meta tags
TWITTER_HANDLE=@showpr
